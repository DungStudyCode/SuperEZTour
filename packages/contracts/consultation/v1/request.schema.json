{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "destinationId",
    "entry",
    "traveler",
    "trip",
    "privacy"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "destinationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "route",
        "locale"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "route": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "locale": {
          "type": "string",
          "enum": [
            "ko",
            "vi"
          ]
        }
      }
    },
    "traveler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "contact"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "value"
          ],
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "phone",
                "email",
                "kakao"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 254
            }
          }
        }
      }
    },
    "trip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "departure",
        "duration",
        "guests",
        "itineraryId",
        "preferences",
        "specialRequests"
      ],
      "properties": {
        "departure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "date"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "undecided",
                "exact"
              ]
            },
            "date": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "duration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "days"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "undecided",
                "fixed"
              ]
            },
            "days": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 999
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "guests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adults",
            "children"
          ],
          "properties": {
            "adults": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999
            },
            "children": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999
            }
          }
        },
        "itineraryId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "preferences": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attractionIds",
            "culinaryIds"
          ],
          "properties": {
            "attractionIds": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "culinaryIds": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        },
        "specialRequests": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyVersion",
        "accepted"
      ],
      "properties": {
        "policyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "accepted": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
