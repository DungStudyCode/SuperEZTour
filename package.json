{
  "name": "superez-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @superez/web",
    "dev:api": "npm run dev --workspace @superez/api",
    "build:web": "npm run build --workspace @superez/web",
    "build:api": "npm run build --workspace @superez/api",
    "build": "npm run build:web && npm run build:api",
    "test": "npm run test --workspace @superez/web && npm run test --workspace @superez/api",
    "typecheck": "npm run typecheck --workspace @superez/api",
    "validate:contracts": "node scripts/validation/validate-contracts.mjs",
    "validate:locales": "node scripts/validation/validate-locales.mjs",
    "migrate:api": "npm run migrate --workspace @superez/api",
    "migrate:api:prod": "npm run migrate:prod --workspace @superez/api",
    "deploy:dry-run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deployment/deploy.ps1 -DryRun"
  }
}
