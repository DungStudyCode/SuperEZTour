# ==============================================================================
# Super EZ Tour — Reference Nginx Configuration Template (DO NOT AUTO-APPLY)
# Target Host: superez.site (Isolated from vivu.site / api.vivu.site)
# Static Root: /var/www/superez/current (atomic symlink release directory)
# Backend Upstream: 127.0.0.1:3103 (@superez/api Fastify service)
# ==============================================================================

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name superez.site www.superez.site;

    # TLS certificates managed on VPS (Let's Encrypt / Certbot)
    ssl_certificate     /etc/letsencrypt/live/superez.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/superez.site/privkey.pem;

    root /var/www/superez/current;
    index index.html;

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Same-origin Consultation API reverse proxy -> @superez/api (127.0.0.1:3103)
    location /api/v1/ {
        client_max_body_size 32k;
        proxy_http_version 1.1;
        proxy_pass http://127.0.0.1:3103;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 15s;
        proxy_connect_timeout 5s;
        add_header Cache-Control "no-store" always;
    }

    # Immutable hashed Vite assets & 3D/WebP media
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        try_files $uri =404;
    }

    # HTML entry & SPA fallback (/destinations/ha-noi, /destinations/da-nang, etc.)
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
